{
  "expo": {
    "name": "IDH Leite",
    "slug": "app-embrapa-idh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "appembrapaidh",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#097E47"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.appembrapaidh",
      "icon": "./src/assets/images/ios-light.png",
      "darkIcon": "./src/assets/images/ios-dark.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "splash": {
        "image": "./src/assets/images/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#097E47"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./src/assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.appembrapaidh",
      "splash": {
        "image": "./src/assets/images/icon-white.png",
        "resizeMode": "contain",
        "backgroundColor": "#097E47"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      "expo-secure-store",
      "expo-notifications",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "99583920-c5c7-442c-bbfe-71715f879de3"
      }
    }
  }
}
