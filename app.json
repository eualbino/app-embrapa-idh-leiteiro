{
  "expo": {
    "name": "IDH Leite",
    "slug": "app-embrapa-idh",
    "version": "1.0.0",
    "description": "Avalie o uso da água e o manejo de dejetos da sua propriedade leiteira com o Índice de Desempenho Hídrico da Embrapa.",
    "orientation": "portrait",
    "icon": "./src/assets/images/ios-light.png",
    "scheme": "appembrapaidh",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#097E47"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.gov.embrapa.idhleite",
      "icon": {
        "light": "./src/assets/images/ios-light.png",
        "dark": "./src/assets/images/ios-dark.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "splash": {
        "image": "./src/assets/images/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#097E47"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./src/assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "br.gov.embrapa.idhleite",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "splash": {
        "image": "./src/assets/images/icon-white.png",
        "resizeMode": "contain",
        "backgroundColor": "#097E47"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      "expo-secure-store",
      "expo-notifications",
      "expo-sqlite",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "99583920-c5c7-442c-bbfe-71715f879de3"
      }
    }
  }
}
